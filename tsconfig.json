{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ES2024", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
